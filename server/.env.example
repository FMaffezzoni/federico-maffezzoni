PORT=5055
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=FedericoAdmin2026!
ADMIN_EMAIL=dott.federicomaffezzoni@gmail.com

# MongoDB Atlas (required for persistent CMS on Render Free)
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=federico_cms

# Public site origin (no trailing slash) — used in reset email links
PUBLIC_SITE_URL=https://federicomaffezzoni.it
# Set to true once, redeploy, log in, then set false
RESET_ADMIN=false
# Optional: always include reset link in API response even when SMTP works
RETURN_RESET_LINK=false
# Optional SMTP (Gmail example) — without this, forgot-password shows the link on screen
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=dott.federicomaffezzoni@gmail.com
# SMTP_PASS=your-gmail-app-password
# SMTP_FROM=dott.federicomaffezzoni@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
